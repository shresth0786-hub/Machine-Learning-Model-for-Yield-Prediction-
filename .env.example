# =============================================================================
# AGROSENSE RAG AGENT CONFIGURATION
# Copy this file to .env (already gitignored) and fill in any keys you want.
# =============================================================================

# --- LLM provider for natural-language answers ------------------------------
#   RAG_PROVIDER=auto  -> uses Gemini if GOOGLE_API_KEY set, else OpenAI if
#                         OPENAI_API_KEY set, else local mode.
#   RAG_PROVIDER=local | gemini | openai  to force one.
RAG_PROVIDER=auto

# Gemini (https://aistudio.google.com/apikey)  + pip install google-generativeai
GOOGLE_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)  + pip install openai
OPENAI_API_KEY=

# --- Web search -------------------------------------------------------------
# Tavily web search works out of the box with NO key (official keyless mode,
# Search/Extract, rate-limited). For higher limits add a free real API key:
#   https://app.tavily.com  (pip install tavily-python optional)
TAVILY_API_KEY=

# Alternative search backends (used only if TAVILY_API_KEY is absent and you
# want a keyed provider). Leave empty to rely on Tavily keyless.
# BRAVE_API_KEY=
# SERP_API_KEY=
